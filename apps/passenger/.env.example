# Copia a apps/passenger/.env.local (Git lo ignora). Vuelve a compilar tras cambiar las claves.

# URL del API. Emulador de Android → tu PC: 10.0.2.2. Móvil físico: la IP de tu PC en la red.
# Mock-server: puerto 4000. API real: 3000.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:4000

# Solo con el mock-server: inicia una sesión falsa al abrir la app (se elimina en la Fase 1).
EXPO_PUBLIC_DEMO_SESSION=1

# Clave maps-android-passenger, restringida a este paquete + SHA-1 (12.5). Sin ella, la app muestra un aviso.
GOOGLE_MAPS_ANDROID_KEY=
