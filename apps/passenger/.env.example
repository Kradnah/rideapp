# Copia a apps/passenger/.env.local (Git lo ignora). Vuelve a compilar tras cambiar las claves.

# URL del API. Emulador de Android → tu PC: 10.0.2.2. Móvil físico: la IP de tu PC en la red.
# Mock-server: puerto 4000. API real: 3000.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:4000


# Clave maps-android-passenger, restringida a este paquete + SHA-1 (12.5). Sin ella, la app muestra un aviso.
GOOGLE_MAPS_ANDROID_KEY=

# Client ID web de Google (no es secreto). La app lo usa como webClientId de Google Sign-In.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=380118449997-lmqk7sup476sflp4vdmadst8unt8ku9b.apps.googleusercontent.com

# Notificaciones push (8.13), opcionales. EAS_PROJECT_ID: ID del proyecto en expo.dev (gratis).
# GOOGLE_SERVICES_FILE: ruta al google-services.json de Firebase (FCM) de este paquete; la clave
# de cuenta de servicio de FCM se sube a Expo con `eas credentials`. Ver apps/passenger/README.md.
# EAS_PROJECT_ID=
# GOOGLE_SERVICES_FILE=./google-services.json
