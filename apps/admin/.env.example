# Copia a apps/admin/.env.local. Las variables VITE_* acaban en el navegador: nunca pongas secretos.
# Clave maps-web-admin, restringida por referente HTTP (12.5). Sin ella, el mapa muestra un aviso.
VITE_GOOGLE_MAPS_KEY=
# URL del API. Por defecto /api (mismo origen; Traefik o el proxy de Vite la redirigen).
VITE_API_URL=/api
# Solo desarrollo: adónde envía /api el proxy de Vite (mock-server: 4000, API real: 3000).
DEV_API_TARGET=http://127.0.0.1:4000
