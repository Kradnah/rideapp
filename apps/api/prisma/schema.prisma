// Esquema de rideapp. La URL de la BD está en prisma.config.ts (Prisma 7).
// Las columnas geography (PostGIS) se declaran como Unsupported(...) y se gestionan con SQL en la migración.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------
// Identidad (Fase 1, sección 8.0)
// ---------------------------------------------------------------------------------------

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum EmailCodePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  APPLE
}

model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  /// citext: único sin distinguir mayúsculas. Null para cuentas anonimizadas (8.3).
  email         String?    @unique @db.Citext
  emailVerified Boolean    @default(false) @map("email_verified")
  /// Argon2id. Null si la cuenta solo entra con Google/Apple.
  passwordHash  String?    @map("password_hash")
  fullName      String     @map("full_name")
  phone         String?
  role          UserRole
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(3)

  identities    AuthIdentity[]
  refreshTokens RefreshToken[]
  consents      Consent[]
  adminTotp     AdminTotp?
  emailCodes    EmailCode[]
  driverProfile DriverProfile?

  @@map("users")
}

/// Identidades externas (Google, Apple). El usuario se identifica por `sub`, nunca por el email (8.2).
model AuthIdentity {
  id              String       @id @default(uuid(7)) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  provider        AuthProvider
  providerSubject String       @map("provider_subject")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

/// Refresh tokens rotativos. Solo se guarda el hash SHA-256 (8.2, paso 3).
/// Una familia = una sesión (`sid` del access token); si se reutiliza un token ya rotado,
/// se revoca la familia entera.
model RefreshToken {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  familyId          String    @map("family_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  userAgent         String?   @map("user_agent")
  ip                String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy        String?   @map("replaced_by") @db.Uuid
  /// Métodos de autenticación de la sesión (pwd, google, totp): se conservan al rotar.
  amr               String[]  @default([])
  /// Sesiones con caducidad por inactividad (panel admin: 30 min) y absoluta (8 h), 11.2.
  idleSeconds       Int?      @map("idle_seconds")
  absoluteExpiresAt DateTime? @map("absolute_expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Segundo factor del panel (8.14). El secreto va cifrado con AES-256-GCM (FIELD_ENCRYPTION_KEY).
model AdminTotp {
  userId       String   @id @map("user_id") @db.Uuid
  secretEnc    String   @map("secret_enc")
  /// Último intervalo de 30 s aceptado: impide reutilizar un código ya usado.
  lastUsedStep BigInt?  @map("last_used_step")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_totp")
}

/// Códigos de 6 dígitos enviados por correo (8.2, paso 6; 14.2). Se guarda el HMAC, nunca el código;
/// máximo 5 intentos y un solo uso.
model EmailCode {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   EmailCodePurpose
  codeHmac  String           @map("code_hmac")
  attempts  Int              @default(0)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("email_codes")
}

/// Prueba de la autorización de tratamiento de datos (Ley 1581, sección 15).
model Consent {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  policyVersion String   @map("policy_version")
  acceptedAt    DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)
  ip            String?
  /// Canal: passenger, driver, admin...
  channel       String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("consents")
}

/// Auditoría (8.15). Sin FK a users: los registros sobreviven al borrado de la cuenta.
model AuditLog {
  id       String   @id @default(uuid(7)) @db.Uuid
  actorId  String?  @map("actor_id") @db.Uuid
  action   String
  entity   String
  entityId String?  @map("entity_id")
  ip       String?
  at       DateTime @default(now()) @db.Timestamptz(3)
  meta     Json?

  @@index([actorId, at])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------------------
// Conductores (Fase 2, sección 8.4)
// ---------------------------------------------------------------------------------------

enum DriverStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VehicleCategory {
  STANDARD
  MOTO
}

enum DriverDocumentType {
  DRIVER_LICENSE
  VEHICLE_REGISTRATION
  SOAT
}

enum DriverDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// Perfil de conductor sobre un usuario con rol DRIVER. Transiciones: PENDING → APPROVED | REJECTED;
/// REJECTED → PENDING (al corregir y reenviar); APPROVED ↔ SUSPENDED.
model DriverProfile {
  userId           String       @id @map("user_id") @db.Uuid
  status           DriverStatus @default(PENDING)
  /// AES-256-GCM (FIELD_ENCRYPTION_KEY). Para mostrarla enmascarada basta `license_last4`.
  licenseNumberEnc String       @map("license_number_enc")
  licenseLast4     String       @map("license_last4")
  /// Cuándo se envió a revisión; null mientras el conductor completa el registro.
  submittedAt      DateTime?    @map("submitted_at") @db.Timestamptz(3)
  /// Motivo del último rechazo o suspensión (lo ve el conductor).
  statusReason     String?      @map("status_reason")
  reviewedBy       String?      @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  approvedAt       DateTime?    @map("approved_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles  Vehicle[]
  documents DriverDocument[]

  @@index([status, submittedAt])
  @@map("driver_profiles")
}

/// Un solo vehículo activo por conductor (índice único parcial en la migración).
model Vehicle {
  id        String          @id @default(uuid(7)) @db.Uuid
  driverId  String          @map("driver_id") @db.Uuid
  plate     String
  brand     String
  model     String
  color     String
  year      Int
  category  VehicleCategory
  active    Boolean         @default(false)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  driver DriverProfile @relation(fields: [driverId], references: [userId], onDelete: Cascade)

  @@unique([driverId, plate])
  @@index([plate])
  @@map("vehicles")
}

/// Documentos del conductor (14.7): el archivo vive cifrado en el StorageService bajo `storage_key`
/// (aleatorio, nunca el nombre original). Uno vigente por tipo: subir otro reemplaza el anterior.
model DriverDocument {
  id         String               @id @default(uuid(7)) @db.Uuid
  driverId   String               @map("driver_id") @db.Uuid
  type       DriverDocumentType
  storageKey String               @unique @map("storage_key")
  mime       String
  sizeBytes  Int                  @map("size_bytes")
  sha256     String
  status     DriverDocumentStatus @default(PENDING)
  reviewedBy String?              @map("reviewed_by") @db.Uuid
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  driver DriverProfile @relation(fields: [driverId], references: [userId], onDelete: Cascade)

  @@unique([driverId, type])
  @@map("driver_documents")
}
