// Esquema de rideapp. La URL de la BD está en prisma.config.ts (Prisma 7).
// Las columnas geography (PostGIS) se declaran como Unsupported(...) y se gestionan con SQL en la migración.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------
// Identidad (Fase 1, sección 8.0)
// ---------------------------------------------------------------------------------------

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum EmailCodePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  APPLE
}

model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  /// citext: único sin distinguir mayúsculas. Null para cuentas anonimizadas (8.3).
  email         String?    @unique @db.Citext
  emailVerified Boolean    @default(false) @map("email_verified")
  /// Argon2id. Null si la cuenta solo entra con Google/Apple.
  passwordHash  String?    @map("password_hash")
  fullName      String     @map("full_name")
  phone         String?
  role          UserRole
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(3)

  identities    AuthIdentity[]
  refreshTokens RefreshToken[]
  consents      Consent[]
  adminTotp     AdminTotp?
  emailCodes    EmailCode[]
  driverProfile DriverProfile?
  fareQuotes    FareQuote[]
  trips         Trip[]         @relation("PassengerTrips")

  @@map("users")
}

/// Identidades externas (Google, Apple). El usuario se identifica por `sub`, nunca por el email (8.2).
model AuthIdentity {
  id              String       @id @default(uuid(7)) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  provider        AuthProvider
  providerSubject String       @map("provider_subject")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

/// Refresh tokens rotativos. Solo se guarda el hash SHA-256 (8.2, paso 3).
/// Una familia = una sesión (`sid` del access token); si se reutiliza un token ya rotado,
/// se revoca la familia entera.
model RefreshToken {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  familyId          String    @map("family_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  userAgent         String?   @map("user_agent")
  ip                String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy        String?   @map("replaced_by") @db.Uuid
  /// Métodos de autenticación de la sesión (pwd, google, totp): se conservan al rotar.
  amr               String[]  @default([])
  /// Sesiones con caducidad por inactividad (panel admin: 30 min) y absoluta (8 h), 11.2.
  idleSeconds       Int?      @map("idle_seconds")
  absoluteExpiresAt DateTime? @map("absolute_expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Segundo factor del panel (8.14). El secreto va cifrado con AES-256-GCM (FIELD_ENCRYPTION_KEY).
model AdminTotp {
  userId       String   @id @map("user_id") @db.Uuid
  secretEnc    String   @map("secret_enc")
  /// Último intervalo de 30 s aceptado: impide reutilizar un código ya usado.
  lastUsedStep BigInt?  @map("last_used_step")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_totp")
}

/// Códigos de 6 dígitos enviados por correo (8.2, paso 6; 14.2). Se guarda el HMAC, nunca el código;
/// máximo 5 intentos y un solo uso.
model EmailCode {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   EmailCodePurpose
  codeHmac  String           @map("code_hmac")
  attempts  Int              @default(0)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("email_codes")
}

/// Prueba de la autorización de tratamiento de datos (Ley 1581, sección 15).
model Consent {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  policyVersion String   @map("policy_version")
  acceptedAt    DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)
  ip            String?
  /// Canal: passenger, driver, admin...
  channel       String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("consents")
}

/// Auditoría (8.15). Sin FK a users: los registros sobreviven al borrado de la cuenta.
model AuditLog {
  id       String   @id @default(uuid(7)) @db.Uuid
  actorId  String?  @map("actor_id") @db.Uuid
  action   String
  entity   String
  entityId String?  @map("entity_id")
  ip       String?
  at       DateTime @default(now()) @db.Timestamptz(3)
  meta     Json?

  @@index([actorId, at])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------------------
// Conductores (Fase 2, sección 8.4)
// ---------------------------------------------------------------------------------------

enum DriverStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VehicleCategory {
  STANDARD
  MOTO
}

enum DriverDocumentType {
  DRIVER_LICENSE
  VEHICLE_REGISTRATION
  SOAT
}

enum DriverDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// Perfil de conductor sobre un usuario con rol DRIVER. Transiciones: PENDING → APPROVED | REJECTED;
/// REJECTED → PENDING (al corregir y reenviar); APPROVED ↔ SUSPENDED.
model DriverProfile {
  userId           String       @id @map("user_id") @db.Uuid
  status           DriverStatus @default(PENDING)
  /// AES-256-GCM (FIELD_ENCRYPTION_KEY). Para mostrarla enmascarada basta `license_last4`.
  licenseNumberEnc String       @map("license_number_enc")
  licenseLast4     String       @map("license_last4")
  /// Cuándo se envió a revisión; null mientras el conductor completa el registro.
  submittedAt      DateTime?    @map("submitted_at") @db.Timestamptz(3)
  /// Motivo del último rechazo o suspensión (lo ve el conductor).
  statusReason     String?      @map("status_reason")
  reviewedBy       String?      @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  approvedAt       DateTime?    @map("approved_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles  Vehicle[]
  documents DriverDocument[]
  trips     Trip[]

  @@index([status, submittedAt])
  @@map("driver_profiles")
}

/// Un solo vehículo activo por conductor (índice único parcial en la migración).
model Vehicle {
  id        String          @id @default(uuid(7)) @db.Uuid
  driverId  String          @map("driver_id") @db.Uuid
  plate     String
  brand     String
  model     String
  color     String
  year      Int
  category  VehicleCategory
  active    Boolean         @default(false)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  driver DriverProfile @relation(fields: [driverId], references: [userId], onDelete: Cascade)
  trips  Trip[]

  @@unique([driverId, plate])
  @@index([plate])
  @@map("vehicles")
}

/// Documentos del conductor (14.7): el archivo vive cifrado en el StorageService bajo `storage_key`
/// (aleatorio, nunca el nombre original). Uno vigente por tipo: subir otro reemplaza el anterior.
model DriverDocument {
  id         String               @id @default(uuid(7)) @db.Uuid
  driverId   String               @map("driver_id") @db.Uuid
  type       DriverDocumentType
  storageKey String               @unique @map("storage_key")
  mime       String
  sizeBytes  Int                  @map("size_bytes")
  sha256     String
  status     DriverDocumentStatus @default(PENDING)
  reviewedBy String?              @map("reviewed_by") @db.Uuid
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  driver DriverProfile @relation(fields: [driverId], references: [userId], onDelete: Cascade)

  @@unique([driverId, type])
  @@map("driver_documents")
}

// ---------------------------------------------------------------------------------------
// Tarifas, cotizaciones y viajes (Fase 3, secciones 8.7–8.9)
// ---------------------------------------------------------------------------------------

/// Zona de servicio (8.6, paso 6): polígono en PostGIS, comprobado con ST_Covers antes de llamar
/// a Google. Se carga en la migración desde infra/geo/service-area.geojson.
model ServiceArea {
  id     Int                                          @id @default(autoincrement())
  name   String                                       @unique
  area   Unsupported("geography(MultiPolygon, 4326)")
  active Boolean                                      @default(true)

  @@index([area], type: Gist)
  @@map("service_areas")
}

enum TripStatus {
  REQUESTED
  SEARCHING
  NO_DRIVERS
  DRIVER_ASSIGNED
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CancelledBy {
  PASSENGER
  DRIVER
  SYSTEM
}

enum PaymentMethod {
  CASH
  FAKE_CARD
}

enum TripEventActor {
  PASSENGER
  DRIVER
  SYSTEM
  ADMIN
}

/// Tarifas por categoría (8.7). Nunca se edita una vigente: se crea otra con `valid_from` (8.14).
model FareRule {
  id           String          @id @default(uuid(7)) @db.Uuid
  category     VehicleCategory
  baseCents    Int             @map("base_cents")
  perKmCents   Int             @map("per_km_cents")
  perMinCents  Int             @map("per_min_cents")
  minFareCents Int             @map("min_fare_cents")
  currency     String          @default("COP")
  validFrom    DateTime        @default(now()) @map("valid_from") @db.Timestamptz(3)
  validTo      DateTime?       @map("valid_to") @db.Timestamptz(3)
  createdBy    String?         @map("created_by") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  quotes FareQuote[]

  @@index([category, validFrom])
  @@map("fare_rules")
}

/// Cotización con caducidad (5 min). Cada una sirve para un solo viaje (`trips.quote_id` único).
model FareQuote {
  id                 String          @id @default(uuid(7)) @db.Uuid
  passengerId        String          @map("passenger_id") @db.Uuid
  fareRuleId         String          @map("fare_rule_id") @db.Uuid
  category           VehicleCategory
  originLat          Float           @map("origin_lat")
  originLng          Float           @map("origin_lng")
  destinationLat     Float           @map("destination_lat")
  destinationLng     Float           @map("destination_lng")
  originAddress      String?         @map("origin_address")
  destinationAddress String?         @map("destination_address")
  destinationPlaceId String?         @map("destination_place_id")
  distanceM          Int             @map("distance_m")
  durationS          Int             @map("duration_s")
  amountCents        Int             @map("amount_cents")
  currency           String
  polyline           String
  expiresAt          DateTime        @map("expires_at") @db.Timestamptz(3)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  passenger User     @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  fareRule  FareRule @relation(fields: [fareRuleId], references: [id])
  trip      Trip?

  @@index([passengerId, createdAt])
  @@index([expiresAt])
  @@map("fare_quotes")
}

/// Viaje (8.8). Solo cambia de estado con TripTransitions (UPDATE ... WHERE status = :from).
/// Índices únicos parciales en la migración: un viaje activo por pasajero y por conductor.
model Trip {
  id                 String                                 @id @default(uuid(7)) @db.Uuid
  passengerId        String                                 @map("passenger_id") @db.Uuid
  driverId           String?                                @map("driver_id") @db.Uuid
  vehicleId          String?                                @map("vehicle_id") @db.Uuid
  quoteId            String                                 @unique @map("quote_id") @db.Uuid
  category           VehicleCategory
  status             TripStatus                             @default(REQUESTED)
  paymentMethod      PaymentMethod                          @map("payment_method")
  originLat          Float                                  @map("origin_lat")
  originLng          Float                                  @map("origin_lng")
  destinationLat     Float                                  @map("destination_lat")
  destinationLng     Float                                  @map("destination_lng")
  /// Generadas a partir de lat/lng (GENERATED ALWAYS ... STORED, en la migración): nunca se escriben.
  origin             Unsupported("geography(Point, 4326)")? @default(dbgenerated("(st_setsrid(st_makepoint(origin_lng, origin_lat), 4326))::geography"))
  destination        Unsupported("geography(Point, 4326)")? @default(dbgenerated("(st_setsrid(st_makepoint(destination_lng, destination_lat), 4326))::geography"))
  originAddress      String?                                @map("origin_address")
  destinationAddress String?                                @map("destination_address")
  /// El place_id se puede guardar sin límite; las coordenadas de Google no (12.3).
  destinationPlaceId String?                                @map("destination_place_id")
  distanceM          Int                                    @map("distance_m")
  durationS          Int                                    @map("duration_s")
  polyline           String
  amountCents        Int                                    @map("amount_cents")
  currency           String
  finalAmountCents   Int?                                   @map("final_amount_cents")
  /// PIN de inicio (8.8, paso 4). Lo dicta el pasajero al conductor.
  pin                String
  /// Ofertas rechazadas o caducadas durante la búsqueda (métricas anti-abuso, 8.9, paso 9).
  offersDeclined     Int                                    @default(0) @map("offers_declined")
  requestedAt        DateTime                               @default(now()) @map("requested_at") @db.Timestamptz(3)
  acceptedAt         DateTime?                              @map("accepted_at") @db.Timestamptz(3)
  arrivedAt          DateTime?                              @map("arrived_at") @db.Timestamptz(3)
  startedAt          DateTime?                              @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?                              @map("completed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?                              @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy        CancelledBy?                           @map("cancelled_by")
  cancelReason       String?                                @map("cancel_reason")
  updatedAt          DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(3)

  passenger User           @relation("PassengerTrips", fields: [passengerId], references: [id])
  driver    DriverProfile? @relation(fields: [driverId], references: [userId])
  vehicle   Vehicle?       @relation(fields: [vehicleId], references: [id])
  quote     FareQuote      @relation(fields: [quoteId], references: [id])
  events    TripEvent[]

  @@index([passengerId, requestedAt(sort: Desc)])
  @@index([driverId, requestedAt(sort: Desc)])
  @@index([status])
  @@index([requestedAt])
  @@index([origin], type: Gist)
  @@index([destination], type: Gist)
  @@map("trips")
}

/// Línea de tiempo del viaje: una fila por transición (8.8, paso 2).
model TripEvent {
  id         String         @id @default(uuid(7)) @db.Uuid
  tripId     String         @map("trip_id") @db.Uuid
  fromStatus TripStatus?    @map("from_status")
  toStatus   TripStatus     @map("to_status")
  actor      TripEventActor
  actorId    String?        @map("actor_id") @db.Uuid
  at         DateTime       @default(now()) @db.Timestamptz(3)
  meta       Json?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, at])
  @@map("trip_events")
}
