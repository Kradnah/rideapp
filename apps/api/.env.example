# Copia a apps/api/.env para desarrollo local. Nunca subas .env a Git.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=debug
TRUST_PROXY=false

# Deben coincidir con infra/.env
DATABASE_URL=postgresql://rideapp:cambia-esto-app@127.0.0.1:5432/rideapp
REDIS_URL=redis://:cambia-esto-redis@127.0.0.1:6379

CORS_ORIGINS=http://localhost:5173

# Clave ES256 de los access tokens (PEM en base64). Genera una propia para desarrollo:
#   node -e "const{generateKeyPairSync:g}=require('crypto');const{privateKey:k}=g('ec',{namedCurve:'prime256v1'});console.log(Buffer.from(k.export({type:'pkcs8',format:'pem'})).toString('base64'))"
JWT_PRIVATE_KEY=
JWT_KID=dev-1
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30

# fake = rutas en línea recta × 1,3 y lugares fijos de Girardot (sin gastar cuota de Google)
# google = Places (New), Geocoding y Routes con la clave de servidor (12.5: maps-server-dev en local)
MAPS_PROVIDER=fake
# GOOGLE_MAPS_SERVER_KEY=

# Client ID "Aplicación web" de Google (no es secreto): audience al verificar el idToken (8.2).
GOOGLE_WEB_CLIENT_ID=380118449997-lmqk7sup476sflp4vdmadst8unt8ku9b.apps.googleusercontent.com

# 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# Correo saliente. Desarrollo: Mailpit (docker compose --profile mail). Producción: SMTP del dominio.
MAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=rideapp <no-reply@rideapp.local>

# Notificaciones push (8.13). expo = Expo Push API (gratis); disabled = no envía (las apps siguen
# funcionando por el socket). Android necesita las credenciales de FCM cargadas en Expo (EAS).
PUSH_PROVIDER=disabled
# EXPO_ACCESS_TOKEN=
