# Copia a apps/api/.env para desarrollo local. Nunca subas .env a Git.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=debug
TRUST_PROXY=false

# Deben coincidir con infra/.env
DATABASE_URL=postgresql://rideapp:cambia-esto-app@127.0.0.1:5432/rideapp
REDIS_URL=redis://:cambia-esto-redis@127.0.0.1:6379

CORS_ORIGINS=http://localhost:5173

# fake = rutas en línea recta × 1,3 y lugares fijos de Girardot (sin gastar cuota de Google)
MAPS_PROVIDER=fake
# GOOGLE_MAPS_SERVER_KEY=
