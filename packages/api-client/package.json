    "zod": "catalog:"
  },
  "devDependencies": {
    "@rideapp/config": "workspace:*",
    "@rideapp/mock-server": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
